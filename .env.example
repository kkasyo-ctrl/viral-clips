# Copy to .env and fill in.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# Optional overrides (defaults in config.py)
# PROB_THRESHOLD=0.6
# SCRIBE_LANGUAGE=en
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=medium
# JEV_MODEL=jev-latest
# CAPTION_FONT=Arial
# CAPTION_SAFE_BOTTOM=0.18
# CAPTION_SAFE_SIDE=0.08
# RENDER_CRF=17
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# Reframing to vertical (step 9, all local)
# REFRAME=true
# REFRAME_ASPECT_RATIO=9:16
# REFRAME_WIDTH=1080
# REFRAME_HEIGHT=1920
# REFRAME_MIN_SEGMENT_SECONDS=1.5
# REFRAME_SAMPLES_PER_SEGMENT=13
# REFRAME_SCENE_THRESHOLD=0.25
# REFRAME_SCENE_MERGE_THRESHOLD=0.25
# REFRAME_DEVICE=cuda
# SCRIBE_DIARIZE=true
